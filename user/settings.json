{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Read(**/.claude/.credentials.json)",
      "Edit(**/.claude/.credentials.json)",
      "Read(**/.git-credentials)",
      "Edit(**/.git-credentials)",
      "Read(**/.pypirc)",
      "Edit(**/.pypirc)",
      "Read(**/.azure/**)",
      "Edit(**/.azure/**)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/authorized_keys)",
      "Edit(**/authorized_keys)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Read(**/.aws/credentials)",
      "Edit(**/.aws/credentials)",
      "Read(**/.config/gcloud/**)",
      "Edit(**/.config/gcloud/**)",
      "Read(**/.netrc)",
      "Edit(**/.netrc)",
      "Read(**/.npmrc)",
      "Edit(**/.npmrc)",
      "Read(**/.docker/config.json)",
      "Edit(**/.docker/config.json)",
      "Read(**/.kube/config)",
      "Edit(**/.kube/config)",
      "Bash(sudo *)",
      "Read(**/*.ppk)",
      "Edit(**/*.ppk)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/AppData/Local/Microsoft/Credentials/**)",
      "Read(**/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(**/AppData/Roaming/Microsoft/Protect/**)",
      "Read(**/AppData/Roaming/gcloud/**)",
      "Edit(**/AppData/Roaming/gcloud/**)",
      "Read(**/System32/config/SAM)",
      "Read(**/System32/config/SYSTEM)",
      "Read(**/System32/config/SECURITY)",
      "Read(**/NTUSER.DAT)",
      "Edit(**/Windows/System32/**)",
      "Edit(**/Windows/SysWOW64/**)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "py {{HOME}}/.claude/statusline.py",
    "refreshInterval": 30
  },
  "language": "japanese",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  }
}

{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--allow-unrestricted-file-access",
        "--output-dir",
        "{{HOME_JSON}}\\AppData\\Local\\Temp/playwright-mcp"
      ],
      "env": {}
    }
  }
}

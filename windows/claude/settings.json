{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE": "1"
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "WebFetch(domain:code.claude.com)",
      "WebSearch",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/authorized_keys)",
      "Edit(**/authorized_keys)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Read(**/.aws/credentials)",
      "Edit(**/.aws/credentials)",
      "Read(**/.config/gcloud/**)",
      "Edit(**/.config/gcloud/**)",
      "Read(**/.netrc)",
      "Edit(**/.netrc)",
      "Read(**/.npmrc)",
      "Edit(**/.npmrc)",
      "Read(**/.docker/config.json)",
      "Edit(**/.docker/config.json)",
      "Read(**/.kube/config)",
      "Edit(**/.kube/config)",
      "Bash(sudo *)",
      "Read(**/*.ppk)",
      "Edit(**/*.ppk)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/AppData/Local/Microsoft/Credentials/**)",
      "Read(**/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(**/AppData/Roaming/Microsoft/Protect/**)",
      "Read(**/AppData/Roaming/gcloud/**)",
      "Edit(**/AppData/Roaming/gcloud/**)",
      "Read(**/System32/config/SAM)",
      "Read(**/System32/config/SYSTEM)",
      "Read(**/System32/config/SECURITY)",
      "Read(**/NTUSER.DAT)",
      "Edit(**/Windows/System32/**)",
      "Edit(**/Windows/SysWOW64/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push -u origin main*)",
      "Bash(git push -u origin master*)",
      "Bash(git reset --hard*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D*)",
      "Bash(git commit --amend*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/venv-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/branch-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash __CLAUDE_HOME__/statusline-command.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
